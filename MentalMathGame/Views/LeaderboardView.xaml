<UserControl x:Class="MentalMathGame.Views.LeaderboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MentalMathGame.Converters">

    <UserControl.Resources>
        <conv:BoolToBackgroundConverter x:Key="BoolToBg"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre supérieure -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="← Retour"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding BackCommand}"
                        Padding="8,4" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="Classement"
                           FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Sélection du mode -->
        <StackPanel Grid.Row="1" Margin="24,20,24,0">
            <TextBlock Text="MODE" FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,8"/>
            <UniformGrid Columns="4">
                <Button Style="{StaticResource GameModeCardStyle}"
                        Background="{Binding IsChronoSelected, Converter={StaticResource BoolToBg}}"
                        Command="{Binding SelectModeCommand}" CommandParameter="Chrono"
                        Height="44" Margin="0,0,4,0"
                        Content="Chrono" FontSize="13"/>
                <Button Style="{StaticResource GameModeCardStyle}"
                        Background="{Binding IsSerieSelected, Converter={StaticResource BoolToBg}}"
                        Command="{Binding SelectModeCommand}" CommandParameter="Serie"
                        Height="44" Margin="2,0,2,0"
                        Content="Série" FontSize="13"/>
                <Button Style="{StaticResource GameModeCardStyle}"
                        Background="{Binding IsSurvieSelected, Converter={StaticResource BoolToBg}}"
                        Command="{Binding SelectModeCommand}" CommandParameter="Survie"
                        Height="44" Margin="2,0,2,0"
                        Content="Survie" FontSize="13"/>
                <Button Style="{StaticResource GameModeCardStyle}"
                        Background="{Binding IsDéfiSelected, Converter={StaticResource BoolToBg}}"
                        Command="{Binding SelectModeCommand}" CommandParameter="DéfiDuJour"
                        Height="44" Margin="4,0,0,0"
                        Content="Défi" FontSize="13"/>
            </UniformGrid>
        </StackPanel>

        <!-- Sélection de la difficulté -->
        <StackPanel Grid.Row="2" Margin="24,14,24,0">
            <TextBlock Text="DIFFICULTÉ" FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,8"/>
            <UniformGrid Columns="3">
                <Button Style="{StaticResource GameModeCardStyle}"
                        Background="{Binding IsFacileSelected, Converter={StaticResource BoolToBg}}"
                        Command="{Binding SelectDifficultyCommand}" CommandParameter="Facile"
                        Height="40" Margin="0,0,4,0"
                        Content="Facile" FontSize="13"/>
                <Button Style="{StaticResource GameModeCardStyle}"
                        Background="{Binding IsMoyenSelected, Converter={StaticResource BoolToBg}}"
                        Command="{Binding SelectDifficultyCommand}" CommandParameter="Moyen"
                        Height="40" Margin="2,0,2,0"
                        Content="Moyen" FontSize="13"/>
                <Button Style="{StaticResource GameModeCardStyle}"
                        Background="{Binding IsDifficileSelected, Converter={StaticResource BoolToBg}}"
                        Command="{Binding SelectDifficultyCommand}" CommandParameter="Difficile"
                        Height="40" Margin="4,0,0,0"
                        Content="Difficile" FontSize="13"/>
            </UniformGrid>
        </StackPanel>

        <!-- Liste des scores -->
        <ScrollViewer Grid.Row="3" Margin="24,16,24,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Aucun score -->
                <TextBlock HorizontalAlignment="Center" Margin="0,48"
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Aucun score enregistré pour ce filtre.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" CornerRadius="8" Padding="16,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentPlayer}" Value="True">
                                                <Setter Property="Background" Value="#1A3A5C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Rang -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding RankDisplay}"
                                               FontSize="20" FontWeight="Bold"
                                               VerticalAlignment="Center"/>

                                    <!-- Nom + Date -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PlayerName}"
                                                   FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DateDisplay}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Streak -->
                                    <Border Grid.Column="2"
                                            Background="{StaticResource SurfaceBrush}"
                                            CornerRadius="6" Padding="10,4" Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Serie : " FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding MaxStreak}"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Score -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Points}"
                                                   FontSize="18" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentPlayer}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text=" pts" FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Rang du joueur courant -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" Padding="24,12">
            <TextBlock Text="{Binding PlayerRankText}"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
