<UserControl x:Class="MentalMathGame.Views.ProfileSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,60,0,40">
            <TextBlock Text="Calcul Mental"
                       Style="{StaticResource TitleStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>
            <TextBlock Text="Sélectionne ton profil pour commencer"
                       Style="{StaticResource SubtitleStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Liste des profils + création -->
        <Grid Grid.Row="1" MaxWidth="500" Margin="40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Profils existants -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProfileCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar initiale -->
                                    <Border Grid.Column="0"
                                            Width="46" Height="46"
                                            CornerRadius="23"
                                            Background="{StaticResource AccentBrush}"
                                            Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Username[0], StringFormat={}{0}}"
                                                   FontSize="20" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"/>
                                    </Border>

                                    <!-- Infos -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Username}"
                                                   FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Statistics.TotalGamesPlayed, StringFormat={}{0} partie(s) jouée(s)}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Bouton jouer -->
                                    <Button Grid.Column="2"
                                            Content="Jouer"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding DataContext.SelectProfileCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="16,8"
                                            Margin="8,0"/>

                                    <!-- Bouton supprimer -->
                                    <Button Grid.Column="3"
                                            Content="✕"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding DataContext.DeleteProfileCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            FontSize="16"
                                            Padding="8,4"
                                            ToolTip="Supprimer ce profil"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Création de profil -->
            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12"
                    Padding="24"
                    Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Nouveau profil"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,10,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CreateProfileCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Content="Créer"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding CreateProfileCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="12"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Pied de page -->
        <TextBlock Grid.Row="2"
                   Text="Calcul Mental v1.0"
                   Style="{StaticResource SubtitleStyle}"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,20"/>
    </Grid>
</UserControl>
