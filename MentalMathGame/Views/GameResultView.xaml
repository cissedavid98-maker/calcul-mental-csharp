<UserControl x:Class="MentalMathGame.Views.GameResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">
        <StackPanel MaxWidth="560"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="40">

            <TextBlock Text="{Binding ResultMessage}"
                       Style="{StaticResource TitleStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <TextBlock HorizontalAlignment="Center"
                       Margin="0,0,0,36"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="14">
                <Run Text="{Binding ModeLabel}"/>
                <Run Text=" — "/>
                <Run Text="{Binding DifficultyLabel}"/>
            </TextBlock>

            <!-- Cartes de statistiques -->
            <UniformGrid Columns="3" Margin="0,0,0,20">
                <!-- Score -->
                <Border Style="{StaticResource ProfileCardStyle}" Margin="0,0,8,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Score final"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Session.FinalScore}"
                                   FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="pts" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Précision -->
                <Border Style="{StaticResource ProfileCardStyle}" Margin="4,0,4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Précision"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding AccuracyText}"
                                   FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Meilleure série -->
                <Border Style="{StaticResource ProfileCardStyle}" Margin="8,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Meilleure série"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Session.MaxStreak}"
                                   FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Ligne de détail -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="20,14" Margin="0,0,0,32">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="14" HorizontalAlignment="Center">
                        <Run Text="{Binding Session.CorrectAnswers}" FontWeight="Bold"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding Session.TotalAnswered}" FontWeight="Bold"/>
                        <Run Text="  bonnes réponses" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="1" FontSize="14" HorizontalAlignment="Center">
                        <Run Text="{Binding DurationText}" FontWeight="Bold"/>
                        <Run Text="  de jeu" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Boutons d'action -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Button Content="Rejouer"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding PlayAgainCommand}"
                        Padding="28,12" FontSize="15" Margin="0,0,12,0"/>
                <Button Content="Menu principal"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding BackToMenuCommand}"
                        Padding="28,12" FontSize="15"/>
            </StackPanel>

            <!-- Nouveaux badges débloqués -->
            <Border Background="#1A3A5C" CornerRadius="8" Padding="20,14"
                    Visibility="{Binding HasNewBadges,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Nouveau badge debloque !"
                               FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding NewBadges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>
